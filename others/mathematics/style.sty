% The original Fitch renderer suppresses formula-box heights. Measure each
% wrapped row before flushing it, so the scope bars and rows share its height.
\makeatletter
\newsavebox{\stProofFormulaBox}
\newsavebox{\stProofReasonBox}
\newlength{\stProofRowHeight}
\newlength{\stProofRowDepth}
\newlength{\stProofRowTopHeight}
\newcommand{\stProofJustification}[2]{\stProofReason{#1\if\relax\detokenize{#2}\relax\else\space(\ndref{#2})\fi}}
\newcommand{\stProofRowSize}[2]{%
  \sbox{\stProofFormulaBox}{$\stProofFormula{#1}$}%
  \sbox{\stProofReasonBox}{#2}%
  \setlength{\stProofRowDepth}{\dp\stProofFormulaBox}%
  \ifdim\dp\stProofReasonBox>\stProofRowDepth
    \setlength{\stProofRowDepth}{\dp\stProofReasonBox}\fi
  \addtolength{\stProofRowDepth}{2pt}%
  \setlength{\stProofRowHeight}{\ht\stProofFormulaBox}%
  \ifdim\ht\stProofReasonBox>\stProofRowHeight
    \setlength{\stProofRowHeight}{\ht\stProofReasonBox}\fi
  \addtolength{\stProofRowHeight}{\stProofRowDepth}%
  \addtolength{\stProofRowHeight}{2pt}%
  \setlength{\stProofRowTopHeight}{\stProofRowHeight}%
  \addtolength{\stProofRowTopHeight}{-1pt}%
  % Alignment cells form groups; the row geometry must survive the first &.
  \global\stProofRowDepth=\stProofRowDepth
  \global\stProofRowHeight=\stProofRowHeight
  \global\stProofRowTopHeight=\stProofRowTopHeight
  \gdef\nd@height{\stProofRowHeight}%
  \gdef\nd@depth{\stProofRowDepth}%
  \gdef\nd@topheight{\stProofRowTopHeight}%
}
\newcommand{\stHave}[5]{%
  \nd@cmd\nd@clr
  \stProofRowSize{#3}{\stProofJustification{#4}{#5}}%
  \have[#1]{#2}{\stProofFormula{#3}}%
  \by{\stProofJustification{#4}{#5}}{}%
  \nd@cmd\nd@clr
}
\newcommand{\stHypo}[3]{%
  \nd@cmd\nd@clr
  \stProofRowSize{#3}{\stProofJustification{}{}}%
  \hypo[#1]{#2}{\stProofFormula{#3}}%
  \nd@cmd\nd@clr
}
\makeatother